# Frontend — used by Vite at build time
# The frontend calls this URL for all API requests.
# Change this only if the API runs on a different port or host.
VITE_API_BASE_URL=http://localhost:8000

# Backend — FastAPI CORS middleware
# Comma-separated list of allowed browser request origins.
# Must include the full URL (protocol + host + port) for each origin.
# Default allows the local Vite dev server on both localhost and 127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173